{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/templates/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/claude.js": {
      "maxDuration": 300
    },
    "api/laporan.js": {
      "maxDuration": 60
    }
  }
}
